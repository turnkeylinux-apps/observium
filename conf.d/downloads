#!/bin/bash -e

VERSION=26.1.14545
ARCHIVE=observium-community-${VERSION}.tar.gz
URL=https://www.observium.org/observium-community-latest.tar.gz
SHA256=01f4bec0bb01c49afe07e26f2b3f79d4eeeabf412ce5f15193df4ed7fc77d715
SRC=/usr/local/src

proxy_args=()
if [ -n "${FAB_HTTP_PROXY:-}" ]; then
    proxy_args=(--proxy "$FAB_HTTP_PROXY")
fi

curl --fail --location --show-error "${proxy_args[@]}" \
    --output "$SRC/$ARCHIVE" "$URL"
echo "$SHA256  $SRC/$ARCHIVE" | sha256sum --check --strict
