#!/bin/bash -e
# regenerate observium secrets and mysql password

. /etc/default/inithooks

CONF=/opt/observium/config.php

set +x
PASSWORD=$(mcookie)

sed -i "s/\(\$config\['db_pass']\).*$/\1 = '$PASSWORD';/" "$CONF"
mysql --batch <<EOF
ALTER USER 'observium'@'localhost' IDENTIFIED BY '$PASSWORD';
EOF
unset PASSWORD
set -x
