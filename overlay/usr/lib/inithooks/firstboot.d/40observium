#!/bin/bash -e
# set observium admin password

. /etc/default/inithooks

set +x
[ -e "$INITHOOKS_CONF" ] && . "$INITHOOKS_CONF"
if [ -n "$APP_PASS" ]; then
    printf '%s' "$APP_PASS" | "$INITHOOKS_PATH/bin/observium.py" --pass-stdin
else
    "$INITHOOKS_PATH/bin/observium.py"
fi
unset APP_PASS
set -x
