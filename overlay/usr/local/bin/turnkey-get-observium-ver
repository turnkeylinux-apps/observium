#!/bin/bash -e

[ "$#" -le 1 ] || {
    echo "Usage: $(basename "$0") [ce]" >&2
    exit 2
}

case "${1:-ce}" in
    ce) ;;
    --help|-h)
        echo "Usage: $(basename "$0") [ce]"
        exit 0
        ;;
    *)
        echo "Only the Observium Community Edition channel is supported." >&2
        exit 2
        ;;
esac

exec turnkey-update-observium --check
